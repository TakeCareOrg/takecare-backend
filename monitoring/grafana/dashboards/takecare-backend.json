{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "type": "stat",
            "title": "Requests / sec (5m)",
            "id": 1,
            "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
            "targets": [
                {
                    "expr": "sum(rate(http_request_duration_seconds_count[5m]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "reqps", "decimals": 2 },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "orientation": "horizontal"
            }
        },
        {
            "type": "stat",
            "title": "Error rate (5xx, 5m)",
            "id": 2,
            "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
            "targets": [
                {
                    "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 0.01 },
                            { "color": "red", "value": 0.05 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "type": "stat",
            "title": "Users created (total)",
            "id": 3,
            "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
            "targets": [{ "expr": "user_created_total", "refId": "A" }]
        },
        {
            "type": "stat",
            "title": "Quizz completed (total)",
            "id": 4,
            "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
            "targets": [{ "expr": "quizz_completed_total", "refId": "A" }]
        },
        {
            "type": "timeseries",
            "title": "Request latency (seconds)",
            "id": 5,
            "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "s" },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Requests by status code (rps)",
            "id": 6,
            "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
            "targets": [
                {
                    "expr": "sum by (status_code) (rate(http_request_duration_seconds_count[5m]))",
                    "legendFormat": "{{status_code}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "reqps" },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Top routes by RPS",
            "id": 7,
            "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
            "targets": [
                {
                    "expr": "topk(10, sum by (path, method) (rate(http_request_duration_seconds_count[5m])))",
                    "legendFormat": "{{method}} {{path}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "reqps" },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "Node.js process (CPU / RSS)",
            "id": 8,
            "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
            "targets": [
                {
                    "expr": "rate(process_cpu_seconds_total[1m])",
                    "legendFormat": "cpu (cores)",
                    "refId": "A"
                },
                {
                    "expr": "process_resident_memory_bytes",
                    "legendFormat": "rss (bytes)",
                    "refId": "B"
                }
            ]
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": ["takecare", "backend"],
    "templating": { "list": [] },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {},
    "timezone": "",
    "title": "TakeCare Backend",
    "uid": "takecare-backend",
    "version": 1,
    "weekStart": ""
}
