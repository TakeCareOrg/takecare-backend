# /etc/nginx/sites-available/grafana-tc.loule.me
#
# Reverse proxy for Grafana, which listens on 127.0.0.1:7001 on the VPS
# (set by monitoring/docker-compose.yml). TLS is terminated here, same
# pattern as api-tc.loule.me / api-beta-tc.loule.me / vault-tc.loule.me.
#
# Install:
#   sudo cp grafana-tc.loule.me.conf.example /etc/nginx/sites-available/grafana-tc.loule.me
#   sudo ln -s /etc/nginx/sites-available/grafana-tc.loule.me /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d grafana-tc.loule.me   # one-shot cert
#   sudo nginx -t && sudo systemctl reload nginx

# HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name grafana-tc.loule.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name grafana-tc.loule.me;

    # Managed by certbot (path will be created by certbot --nginx)
    ssl_certificate     /etc/letsencrypt/live/grafana-tc.loule.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/grafana-tc.loule.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Grafana
    location / {
        proxy_pass http://127.0.0.1:7001;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (Grafana Live, alerts streaming)
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long-running queries / streamed dashboards
        proxy_read_timeout 120s;
    }
}
