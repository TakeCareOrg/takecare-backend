# Copy to monitoring/.env and fill in.
# Loaded automatically by `docker compose` when run from the monitoring/ directory.

# Grafana admin password (required). User is "admin" by default.
GRAFANA_PASSWORD=change-me

# Public domain for Grafana (used for root URL, cookie domain).
# Nginx terminates TLS for this hostname and proxies to 127.0.0.1:7001.
GRAFANA_DOMAIN=grafana-tc.loule.me
