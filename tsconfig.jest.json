{
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "types": ["jest"],
        "baseUrl": "./src",
        "paths": {
            "@middlewares/*": ["middlewares/*"],
            "@routes/*": ["routes/*"],
            "@libs/*": ["libs/*"],
            "@models/*": ["models/*"],
            "@services/*": ["services/*"],
            "@dtypes/*": ["types/*"],
            "@utils/*": ["utils/*"],
            "@controllers/*": ["controllers/*"],
            "@database/*": ["database/*"],
            "@config/*": ["config/*"],
            "@docs/*": ["docs/*"]
        }
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules"]
}
