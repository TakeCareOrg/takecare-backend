{
    "name": "takecare-backend",
    "version": "1.0.0",
    "main": "index.js",
    "_moduleAliases": {
        "@middlewares": "dist/middlewares",
        "@routes": "dist/routes",
        "@libs": "dist/libs",
        "@dtypes": "dist/types",
        "@utils": "dist/utils",
        "@services": "dist/services",
        "@models": "dist/models",
        "@controllers": "dist/controllers",
        "@database": "dist/database"
    },
    "scripts": {
        "test": "jest --coverage",
        "build": "tsc",
        "start": "node -r module-alias/register dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
        "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TakeCareOrg/takecare-backend.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/TakeCareOrg/takecare-backend/issues"
    },
    "homepage": "https://github.com/TakeCareOrg/takecare-backend#readme",
    "description": "",
    "dependencies": {
        "@types/morgan": "^1.9.9",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "mongoose": "^8.19.1",
        "morgan": "^1.10.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^9.21.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.13.5",
        "@types/supertest": "^6.0.2",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.25.0",
        "@typescript-eslint/parser": "^8.25.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.0.2",
        "eslint-plugin-prettier": "^5.2.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-ts-webcompat-resolver": "^1.0.0",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.6",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    }
}
